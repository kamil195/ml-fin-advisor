# ── Supabase JWT verification (serving layer) ──────────────
# Base URL of the Supabase project; the JWKS endpoint and expected issuer are
# derived from this value (e.g. https://<project-ref>.supabase.co).
SUPABASE_URL=https://your-project-ref.supabase.co
# Expected JWT audience for Supabase access tokens ("authenticated" default).
SUPABASE_JWT_AUDIENCE=authenticated

# ── STEP 12: user-owned persistence (Supabase Postgres, SERVER-SIDE ONLY) ──
# Direct Postgres connection string for the backend, e.g. the Supabase
# "Connection string" from your project settings (Transaction/Session pooler
# or direct host). Never exposed to the frontend; never committed with real
# credentials. Leave unset to run WITHOUT persistence (user-data routes then
# return a generic 503; all other routes are unaffected).
DATABASE_URL=postgresql://postgres:CHANGE-ME@db.your-project-ref.supabase.co:5432/postgres
# Connection timeout in seconds (clamped to [1, 30]; default 5).
DATABASE_CONNECT_TIMEOUT=5

# ── SECURITY STEP 6: rate limiting / abuse protection ──────
# Identity-aware throttle for authenticated financial endpoints, keyed by the
# verified JWT subject (single-worker in-memory sliding window).
RATE_LIMIT_ENABLED=true
# Max authenticated financial requests per user per window.
RATE_LIMIT_REQUESTS=60
# Sliding-window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# ── SECURITY STEP 7: HTTP / browser boundary hardening ────────────────
# Explicit host allowlist (no ports, no wildcards). Add your production
# API hostname when deploying, e.g. api.planwisely.com.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Explicit CORS origin allowlist for browser clients (exact scheme://host[:port]).
# Never use "*" — the application rejects wildcard configuration.
# Production example (known frontend deployment, confirm before use):
#   CORS_ALLOWED_ORIGINS=https://useplanwisely.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Enable Strict-Transport-Security ONLY when served over HTTPS behind a
# trusted reverse proxy. Value: max-age=31536000; includeSubDomains
SECURITY_HSTS_ENABLED=false
# TrustedHost allowlist: add the REAL production API hostname at deploy time
# (e.g. ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api.your-domain.example).
# Do not invent a hostname — it must match the actual deployment.


